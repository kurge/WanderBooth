# The local Host uses port 4174 unless changed here.
WANDERBOOTH_HOST_PORT=4174

# Optional absolute path for runtime photos and the SQLite database.
# Never point this at a Git-tracked folder containing real customer data.
# WANDERBOOTH_DATA_DIR=/absolute/path/to/private/runtime-data

# Optional explicit FFmpeg binary. The Mac app checks Homebrew's common paths automatically.
# WANDERBOOTH_FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

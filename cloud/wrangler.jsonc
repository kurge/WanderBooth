{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "wanderbooth-delivery",
  "main": "../src/cloud/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "wanderbooth-delivery"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wanderbooth-delivery",
      "database_id": "bcf0d476-f463-451c-8871-b3f0c5cd2190",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  }
}
